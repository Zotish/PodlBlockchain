# Public build configuration only. Never put secrets or validator keys in VITE_*.
VITE_API_BASE=https://api.178-105-133-94.sslip.io
VITE_CHAIN_BASE=https://chain.178-105-133-94.sslip.io
VITE_WALLET_BASE=https://wallet.178-105-133-94.sslip.io
VITE_DEX_REGISTRY_API=https://dex-api.178-105-133-94.sslip.io

# Obtain these trust roots independently from the operator-approved genesis and
# validator roster. Leaving them empty deliberately disables verified labels.
VITE_TRUSTED_CHAIN_ID=
VITE_TRUSTED_NETWORK_ID=
VITE_TRUSTED_SPEC_HASH=
VITE_TRUSTED_VALIDATORS=

# Enable only for an explicitly pinned V4 network with worthless test assets.
VITE_ENABLE_TESTNET_SIGNING=false
