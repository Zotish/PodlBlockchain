# Required validator / chain config
VALIDATOR_ADDRESS=0xYourValidatorAddressHere
STAKE_AMOUNT=3000000
MIN_STAKE=100000
MINING_ENABLED=true
P2P_PORT=6100

# Isolated validator signer. Keep false until signer-secrets contains the
# encrypted validator key, passphrase and mTLS files documented in
# docs/VALIDATOR_SIGNER_AND_ECVRF.md. Then set true and require signed BFT.
ENABLE_VALIDATOR_SIGNER=false
LQD_REQUIRE_SIGNED_BFT=false
LQD_VALIDATOR_SIGNER_URL=https://signer:9101
LQD_VALIDATOR_SIGNER_CA=/run/podl-signer/ca.crt
LQD_VALIDATOR_SIGNER_CERT=/run/podl-signer/chain-client.crt
LQD_VALIDATOR_SIGNER_KEY=/run/podl-signer/chain-client.key
LQD_VALIDATOR_SIGNER_NAME=signer
LQD_VALIDATOR_SLASHING_DB=/app/data/signer/slashing-protection.json

# Security / CORS
LQD_API_KEY=replace-with-a-long-random-secret
DEX_REGISTRY_ADMIN_KEY=replace-with-another-long-random-secret
LQD_ALLOWED_ORIGINS=https://your-explorer.netlify.app,https://your-swap.netlify.app,https://your-bridge-admin.netlify.app
# Optional: add custom public-preview suffixes, or temporarily set
# LQD_ALLOWED_ORIGINS=* while debugging browser CORS. Keep exact origins in production.
LQD_ALLOWED_ORIGIN_SUFFIXES=.netlify.app,.vercel.app,.railway.app,.sslip.io

# Optional public bind values.
# Keep HTTP services on localhost when Caddy is enabled.
CHAIN_HTTP_BIND=127.0.0.1:6500
WALLET_HTTP_BIND=127.0.0.1:8080
AGG_HTTP_BIND=127.0.0.1:9000
DEX_API_HTTP_BIND=127.0.0.1:9100
P2P_BIND=0.0.0.0:6100

# Optional HTTPS reverse proxy. Set ENABLE_CADDY=true after DNS points to VPS.
ENABLE_CADDY=false
CHAIN_DOMAIN=chain.example.com
WALLET_DOMAIN=wallet.example.com
AGG_DOMAIN=agg.example.com
DEX_API_DOMAIN=dex-api.example.com

# Ops automation
BACKUP_RETENTION_DAYS=14
MONITOR_WEBHOOK_URL=
MONITOR_RESTART_UNHEALTHY=true

# BSC bridge example. Fill only after contracts are deployed.
BSC_BRIDGE_ENABLED=false
BSC_TESTNET_RPC=
BSC_TESTNET_PRIVATE_KEY=
BSC_BRIDGE_ADDRESS=
BSC_LOCK_ADDRESS=
BSC_CHAIN_ID=97

# Generic bridge tuning
BRIDGE_POLL_INTERVAL_SEC=5
BRIDGE_BACKFILL_BLOCKS=200
BRIDGE_PRIVATE_BATCH_SIZE=3
BRIDGE_PRIVATE_BATCH_MAX_SIZE=8
BRIDGE_PRIVATE_BATCH_WAIT_SEC=45
