# Required validator / chain config
VALIDATOR_ADDRESS=0xYourValidatorAddressHere
STAKE_AMOUNT=3000000
MIN_STAKE=100000
MINING_ENABLED=true
P2P_PORT=6100

# Security / CORS
LQD_API_KEY=replace-with-a-long-random-secret
LQD_ALLOWED_ORIGINS=https://your-explorer.netlify.app,https://your-swap.netlify.app,https://your-bridge-admin.netlify.app

# Optional public bind values.
# Keep HTTP services on localhost when Caddy is enabled.
CHAIN_HTTP_BIND=127.0.0.1:6500
WALLET_HTTP_BIND=127.0.0.1:8080
AGG_HTTP_BIND=127.0.0.1:9000
P2P_BIND=0.0.0.0:6100

# Optional HTTPS reverse proxy. Set ENABLE_CADDY=true after DNS points to VPS.
ENABLE_CADDY=false
CHAIN_DOMAIN=chain.example.com
WALLET_DOMAIN=wallet.example.com
AGG_DOMAIN=agg.example.com

# BSC bridge example. Fill only after contracts are deployed.
BSC_BRIDGE_ENABLED=false
BSC_TESTNET_RPC=
BSC_TESTNET_PRIVATE_KEY=
BSC_BRIDGE_ADDRESS=
BSC_LOCK_ADDRESS=
BSC_CHAIN_ID=97

# Generic bridge tuning
BRIDGE_POLL_INTERVAL_SEC=5
BRIDGE_BACKFILL_BLOCKS=200
BRIDGE_PRIVATE_BATCH_SIZE=3
BRIDGE_PRIVATE_BATCH_MAX_SIZE=8
BRIDGE_PRIVATE_BATCH_WAIT_SEC=45
