[Unit]
Description=PODL Docker Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/podl
Environment=COMPOSE_PROFILES=proxy
ExecStart=/usr/bin/docker compose --profile proxy up -d --remove-orphans
ExecStop=/usr/bin/docker compose --profile proxy stop
RemainAfterExit=yes
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
