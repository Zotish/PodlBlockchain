[Unit]
Description=PODL Docker Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/podl
Environment=PODL_ROOT=/opt/podl
ExecStart=/bin/sh /opt/podl/app/scripts/ops/podl_stack.sh start
ExecStop=/bin/sh /opt/podl/app/scripts/ops/podl_stack.sh stop
RemainAfterExit=yes
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
